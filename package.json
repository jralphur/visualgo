{
  "name": "visualgo",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build:frontend": "npm run build -w frontend",
    "build:backend": "npm run build -w backend",
    "build": "run-s build:backend build:frontend",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "dev": "run-p dev:*",
    "start:frontend": "npm run start -w frontend",
    "start:backend": "npm run start -w backend",
    "start": "run-p start:*",
    "test-dev": "start-server-and-test dev 3000 test:e2e",
    "test-start": "start-server-and-test start 3000 test:e2e"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "start-server-and-test": "^1.12.0",
    "wait-port": "^1.0.1"
  },
  "version": "11.8.0"
}
